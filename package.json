{
  "name": "journey-first-review-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:reachability": "REACHABILITY=true webpack --mode production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:journeys": "playwright test",
    "test:critical": "playwright test --grep @critical",
    "test:visual": "playwright test tests/visual",
    "reachability": "REACHABILITY=true playwright test && tsx scripts/merge-coverage.ts && tsx scripts/build-product-reachability-report.ts",
    "classify-pr": "tsx scripts/classify-pr.ts",
    "select-journeys": "tsx scripts/select-playwright-suites.ts"
  },
  "dependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "babel-loader": "^9.2.1",
    "babel-plugin-istanbul": "^7.0.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.1",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/micromatch": "4.0.10",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "glob": "^11.0.1",
    "istanbul-lib-coverage": "^3.2.2",
    "micromatch": "^4.0.8",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "yaml": "^2.7.0"
  }
}
